# Copy this file to .env and fill it in.

# The group the bot manages. Leave empty on the first run, then message the bot
# "!groups" from an admin number to get the ID (it looks like 1203630xxxxxxxx@g.us).
GROUP_JID=

# Optional. If empty, the bot fetches the group's invite link itself.
GROUP_INVITE_LINK=

# Admin phone numbers with country code, digits only, separated by commas.
ADMIN_NUMBERS=919876543210

# Optional. The bot's own number (digits only). If set, you log in with a pairing
# code typed into WhatsApp instead of scanning a QR code.
PAIRING_NUMBER=

# Join requests from people who never answer the questions are rejected after this many hours.
EXPIRE_HOURS=72
# Connect requests (job match, referral, expert) expire after this many hours.
ASK_EXPIRE_HOURS=48
# A member receives at most this many connect requests per week.
MAX_ASKS_PER_WEEK=3
# A member can make at most this many requests (job posts, referral, expert) per day.
MAX_REQUESTS_PER_DAY=3
# A new job is sent to at most this many matching members.
JOB_MATCH_LIMIT=10
# Jobs close automatically after this many days.
JOB_EXPIRE_DAYS=30

# Daily group post: minute hour day month weekday. Default is 09:30 every day.
CONTENT_CRON=30 9 * * *
TIMEZONE=Asia/Kolkata
